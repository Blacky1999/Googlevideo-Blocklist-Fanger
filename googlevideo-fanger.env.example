# Nach /etc/googlevideo-fanger.env kopieren und mit chmod 0600 schützen.
# Niemals echte Schlüssel oder Tokens in Git committen.

# Persönlicher AdGuard-DNS-API-Key für Query Logs.
ADGUARD_DNS_API_KEY=DEIN_NEUER_ADGUARD_DNS_API_KEY

# GitHub Fine-grained Personal Access Token mit Contents: Read and write
# ausschließlich für Blacky1999/Googlevideo-Blocklist-Fanger.
GITHUB_TOKEN=DEIN_GITHUB_FINE_GRAINED_TOKEN
GITHUB_REPOSITORY=Blacky1999/Googlevideo-Blocklist-Fanger
GITHUB_BRANCH=main
GITHUB_BLOCKLIST_PATH=googlevideo-blocklist.txt

# Laufzeitparameter.
ADGUARD_DNS_LOOKBACK_SECONDS=86400
GV_INTERVAL=300
GV_LOG_LEVEL=INFO
