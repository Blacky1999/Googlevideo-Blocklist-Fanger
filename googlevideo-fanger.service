[Unit]
Description=Googlevideo-Blocklist-Fanger
After=network.target

[Service]
Type=simple
User=googlevideo-fanger
Group=googlevideo-fanger
WorkingDirectory=/opt/googlevideo-blocklist-fanger
EnvironmentFile=-/etc/googlevideo-fanger.env
ExecStart=/usr/bin/python3 /opt/googlevideo-blocklist-fanger/googlevideo_fanger.py --source /var/log/dnsmasq.log --output /var/lib/googlevideo-fanger/googlevideo-blocklist.txt --state /var/lib/googlevideo-fanger/state.json --allowlist /etc/googlevideo-fanger-allowlist.txt --interval 300
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/log/dnsmasq.log
ReadWritePaths=/var/lib/googlevideo-fanger

[Install]
WantedBy=multi-user.target
